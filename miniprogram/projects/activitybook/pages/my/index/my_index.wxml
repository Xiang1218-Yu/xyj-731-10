<view class="main {{skin.IS_SUB?'sub-margin-bottom':''}}">

	<!--top area begin-->
	<view class="upside upside-shadow" bindtap="url" data-url="{{user?'../edit/my_edit':'../reg/my_reg'}}">
		<image mode="aspectFill" lazy-load class="upImg loading" src="../../../images/my.jpg" />
		<view class="user-bar">
		<view class="avatar" wx:if="{{!user.USER_PIC}}">
				<image mode="aspectFit" src="../../../images/tabbar/my_cur.png" />
			</view>
			<image wx:else src="{{user.USER_PIC}}" class="avatar loading" mode="aspectFill" />
			<view class="detail">
				<view class="name text-cut">{{user?user.USER_NAME:'欢迎回来~~'}}</view>
				<view class="desc">
					<view wx:if="{{user&&user.USER_STATUS==9}}" class="tag small radius bg-purple light">已禁用</view>
					<view wx:elif="{{user&&user.USER_STATUS==0}}" class="tag small radius bg-orange light">已注册，待审核</view>
					<view wx:elif="{{user&&user.USER_STATUS==8}}" class="tag small radius bg-red light">审核未通过，请修改资料</view>
					<view wx:else class="text-cut">{{user?'欢迎回来~~':'马上注册，使用更多功能'}}</view>
				</view>
			</view>
			
		</view>
	</view>
	<!--top area end-->

	<view class="record padding-project">
		<view class="inner card-project shadow-project">
			<view class="item" bindtap="url" data-url="../../enroll/my_user_list/enroll_my_user_list">
				<text class="icon-formfill" style="color: #f79091;"></text>
				<view class="title">我的打卡</view>
			</view>
			<view class="mid"></view>
			<view class="item"  bindtap="url" data-url="../../activity/my_join_list/activity_my_join_list">
				<text class="icon-activityfill" style="color: #26d9f5;"></text>
				<view class="title">我的活动</view>
			</view>
		</view>

	</view>

	<!--统计卡片区域 begin-->
	<view class="stat padding-project" wx:if="{{stat}}">
		<view class="stat-grid card-project shadow-project">
			<!-- 活动报名数 -->
			<view class="stat-card" bindtap="url" data-url="../../activity/my_join_list/activity_my_join_list">
				<view class="stat-icon icon-bg-blue">
					<text class="icon-activityfill"></text>
				</view>
				<view class="stat-info">
					<view class="stat-num">{{stat.activityJoinCnt}}</view>
					<view class="stat-label">活动报名数</view>
				</view>
			</view>
			<!-- 打卡天数 -->
			<view class="stat-card" bindtap="url" data-url="../../enroll/my_user_list/enroll_my_user_list">
				<view class="stat-icon icon-bg-red">
					<text class="icon-formfill"></text>
				</view>
				<view class="stat-info">
					<view class="stat-num">{{stat.enrollJoinCnt}}</view>
					<view class="stat-label">打卡天数</view>
				</view>
			</view>
			<!-- 收藏数 -->
			<view class="stat-card" bindtap="url" data-url="../fav/my_fav">
				<view class="stat-icon icon-bg-orange">
					<text class="icon-favor"></text>
				</view>
				<view class="stat-info">
					<view class="stat-num">{{stat.favCnt}}</view>
					<view class="stat-label">收藏数</view>
				</view>
			</view>
			<!-- 待审核数：为0时灰色 -->
			<view class="stat-card {{stat.activityWaitCnt==0?'stat-card-disabled':''}}" bindtap="url" data-url="../../activity/my_join_list/activity_my_join_list">
				<view class="stat-icon {{stat.activityWaitCnt==0?'icon-bg-grey':'icon-bg-purple'}}">
					<text class="icon-activity"></text>
				</view>
				<view class="stat-info">
					<view class="stat-num">{{stat.activityWaitCnt}}</view>
					<view class="stat-label">待审核数</view>
				</view>
			</view>
		</view>

		<!-- 30天打卡趋势图 -->
		<view class="stat-chart card-project shadow-project" wx:if="{{stat.last30DaysTrend&&stat.last30DaysTrend.length>0}}">
			<view class="chart-title">近30天打卡趋势</view>
			<canvas canvas-id="statChart" class="chart-canvas" id="statChart"></canvas>
		</view>
	</view>
	<!--统计卡片区域 end-->

	<!--down area begin-->
	<view class="down padding-project">

		<!--base begin -->
		<view class="comm-list menu card-project shadow-project">
			<view wx:if="{{user&&user.USER_STATUS!=9}}" class="item arrow" bindtap="url" data-url="../edit/my_edit">
				<view class="content">
					<text class="icon-edit my-icon-project"></text>
					<text class="text-black">修改我的个人资料</text>
				</view>
			</view>

			<view class="item arrow" bindtap="url" data-url="../../activity/my_join_list/activity_my_join_list">
				<view class="content">
					<text class="icon-activity my-icon-project"></text>
					<text class="text-black">我的活动报名</text>
				</view>
			</view>


			<view class="item arrow" bindtap="url" data-url="../../enroll/my_user_list/enroll_my_user_list">
				<view class="content">
					<text class="icon-form my-icon-project"></text>
					<text class="text-black">我的打卡</text>
				</view>
			</view>

			<view class="item arrow" bindtap="url" data-url="../fav/my_fav">
				<view class="content">
					<text class="icon-favor my-icon-project"></text>
					<text class="text-black">我的收藏</text>
				</view>
			</view>

			<view class="item arrow" bindtap="url" data-url="../foot/my_foot">
				<view class="content">
					<text class="icon-footprint my-icon-project"></text>
					<text class="text-black">历史浏览</text>
				</view>
			</view>
	 

			<view wx:if="{{skin.IS_SUB}}" class="item arrow" bindtap="bindSetTap">
				<view class="content">
					<text class="icon-settings my-icon-project"></text>
					<text class="text-red text-bold ">系统后台管理<text class="text-grey text-normal">（点击试用）</text></text>
				</view>
			</view>

			<view class="item arrow" bindtap="url" data-url="../../about/index/about_index?key=SETUP_CONTENT_ABOUT">
				<view class="content">
					<text class="icon-service my-icon-project"></text>
					<text class="text-black">关于我们</text>
				</view>
			</view>

			<view wx:if="{{skin.IS_SUB}}" class="item arrow" bindtap="url" data-url="/pages/home/about/home_about">
				<view class="content">
					<text class="icon-phone my-icon-project"></text>
					<text class="text-orange">联系作者了解更多详情</text>
				</view>
			</view>

			<view wx:if="{{!skin.IS_SUB}}" class="item arrow" bindtap="bindSetTap">
				<view class="content">
					<text class="icon-settings my-icon-project"></text>
					<text class="text-black">设置</text>
				</view>
			</view>

		</view>
		<!--sys end -->

	</view>
	<!--down area end-->

</view>
<view style="height:100rpx"></view>



<block wx:if="{{skin.IS_SUB}}">
	<import src="../../tpls/menu_tpl.wxml" />
	<template is="menuTpl" data="{{curMenu:'my_index',returnHome:false}}" />
</block>