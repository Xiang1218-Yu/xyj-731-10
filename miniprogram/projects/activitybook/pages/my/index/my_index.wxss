@import "../../../style/skin.wxss";



.main {
	padding: 0;
}

.main .upside {
	background-color: rgba(75, 148, 231, 0.1);
	height: 450rpx;
	width: 100%;
	display: flex;
	align-items: center;
	justify-content: center;
	position: relative;
	overflow: hidden;
	padding-top: 30rpx;
}

.main .upside .upImg {
	height: inherit;
	width: 100%;
	position: absolute;
	top: 0;
	left: 0;
}

.main .upside .user-bar {
	width: 100%;
	display: flex;
	flex-direction: column;
	justify-content: center;
	align-items: center;
	z-index: 9999;
}

.main .upside .user-bar .avatar {
	height: 130rpx;
	width: 130rpx;
	border: 4rpx solid #fff;
	font-size: 80rpx;
	border-radius: 50%;
	background-color: rgba(255, 255, 255, .8);
	display: flex;
	align-items: center;
	justify-content: center;
}

.main .upside .user-bar .avatar image {
	height: 70rpx;
	width: 70rpx;
}

.main .upside .user-bar .detail {
	width: 100%;
	display: flex;
	flex-direction: column;
	justify-content: center;
	align-items: center;
	color: #fff;
	box-sizing: border-box;
}

.main .upside .user-bar .detail .name {
	width: 100%;
	font-size: 36rpx;
	font-weight: bold;
	color: #fff;
	text-align: center;
	margin-top: 10rpx;
}

.main .upside .user-bar .detail .desc {
	width: 100%;
	font-size: 26rpx;
	margin-top: 0rpx;
	color: #fff;
	text-align: center;
}

.main .record {
	width: 100%;
	position: relative;
	margin-top: 10rpx;
}

.main .record .inner {
	width: 100%;
	display: flex;
	align-items: center;
	justify-content: space-evenly;
	background-color: #fff;
	padding: 40rpx 0rpx;
	border-radius: 16rpx !important;
}

.main .record .inner .item {
	display: flex;
	align-items: center;
}

.main .record .inner .mid {
	height: 40rpx;
	width: 2rpx;
	border-left: 2rpx dashed #ccc;
}


.main .record .inner text {
	font-size: 36rpx;
}

.main .record .inner .item .title {
	font-size: 30rpx;
	font-weight: bold;
	margin-left: 10rpx;
	color: #333;
}

.main .down {
	box-sizing: border-box;
	width: 100%;
	display: flex;
	flex-direction: column;
	justify-content: center;
	padding: 20rpx 20rpx !important;
	position: relative;
}

.main .comm-list .item.arrow::before,
.main .comm-list .item .content .item-icon {
	color: #0E9489;
}

.main .site-footer {
	width: 100%;
	align-self: flex-end;
}

.main .upside-shadow {
	box-shadow: unset
}

.down .comm-list.menu.card-project {
	border-radius: 10rpx !important;
	border-bottom-left-radius: 40rpx !important;
	border-top-right-radius: 40rpx !important;
}

/* 功能点：我的数据统计卡片 */
.main .stat {
	width: 100%;
	position: relative;
	margin-top: 20rpx;
}

.main .stat .inner {
	width: 100%;
	background-color: #fff;
	border-radius: 16rpx !important;
	padding: 30rpx;
	box-sizing: border-box;
}

.main .stat .stat-title {
	display: flex;
	align-items: center;
	font-size: 30rpx;
	font-weight: bold;
}

.main .stat .stat-title .icon-rank {
	margin-right: 10rpx;
	font-size: 34rpx;
}

.main .stat .stat-grid {
	width: 100%;
	display: flex;
	flex-wrap: wrap;
	margin-top: 30rpx;
}

.main .stat .stat-grid .cell {
	width: 33.33%;
	display: flex;
	flex-direction: column;
	align-items: center;
	margin-bottom: 30rpx;
}

.main .stat .stat-grid .cell .num {
	font-size: 40rpx;
	font-weight: bold;
	color: var(--projectColor);
}

.main .stat .stat-grid .cell .label {
	font-size: 24rpx;
	color: #999;
	margin-top: 6rpx;
}

.main .stat .chart-box {
	width: 100%;
	margin-top: 10rpx;
}

.main .stat .chart-box .chart-title {
	font-size: 26rpx;
	color: #666;
	margin-bottom: 20rpx;
}

.main .stat .stat-canvas {
	display: block;
}

.main .stat .stat-loading {
	min-height: 200rpx;
}

.main .stat .stat-login {
	display: flex;
	align-items: center;
	font-size: 28rpx;
}

.main .stat .stat-login .icon-rank {
	margin-right: 10rpx;
	font-size: 34rpx;
}