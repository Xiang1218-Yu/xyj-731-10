@import "../../../style/skin.wxss";

page {
	background-color: #f1f1f1;
}

.poster-page {
	width: 100%;
	display: flex;
	flex-direction: column;
	align-items: center;
	padding-top: 30rpx;
}

/* 海报预览画布（与设计尺寸 480x780 等比缩放） */
.canvas-wrap {
	position: relative;
	width: 560rpx;
	height: 910rpx;
	border-radius: 20rpx;
	overflow: hidden;
}

.poster-canvas {
	width: 560rpx;
	height: 910rpx;
}

/* 海报生成中的提示遮罩 */
.canvas-tip {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	display: flex;
	align-items: center;
	justify-content: center;
	background-color: #fff;
	color: #999;
	font-size: 26rpx;
}

/* 模版切换栏 */
.tpl-bar {
	width: 100%;
	display: flex;
	justify-content: center;
	margin-top: 40rpx;
}

.tpl-item {
	display: flex;
	flex-direction: column;
	align-items: center;
	margin: 0 30rpx;
}

.tpl-item .tpl-color {
	width: 80rpx;
	height: 80rpx;
	border-radius: 16rpx;
	border: 4rpx solid #fff;
	box-sizing: border-box;
}

.tpl-item.cur .tpl-color {
	border-color: var(--projectColor);
}

.tpl-item .tpl-name {
	margin-top: 10rpx;
	font-size: 24rpx;
	color: #666;
}

.tpl-item.cur .tpl-name {
	color: var(--projectColor);
	font-weight: bold;
}

/* 保存到相册按钮 */
.save-wrap {
	width: 100%;
	padding: 40rpx 60rpx;
	box-sizing: border-box;
}

.save-btn {
	height: 90rpx;
	line-height: 90rpx;
	text-align: center;
	color: #fff;
	background-color: var(--projectColor);
	border-radius: 50rpx;
	font-size: 30rpx;
}

.save-btn.disabled {
	background-color: #ccc;
	color: #f5f5f5;
}
