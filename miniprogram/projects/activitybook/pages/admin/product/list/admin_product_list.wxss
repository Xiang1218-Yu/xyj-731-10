@import '../../../../../../style/public/admin.wxss';
@import '../../../../../../style/project/admin_list_style.wxss';

page {
	background-color: #f8f8f8;
}

/* 批量操作工具栏 */
.batch-bar {
	display: flex;
	align-items: center;
	justify-content: space-between;
	background: #fff;
	padding: 16rpx 20rpx;
	margin: 10rpx 20rpx;
	border-radius: 12rpx;
	flex-wrap: wrap;
}

.batch-bar .batch-left {
	font-size: 28rpx;
	color: #333;
}

.batch-bar .batch-info {
	font-size: 26rpx;
	color: #999;
}

.batch-bar .batch-oprt {
	display: flex;
	align-items: center;
}

.batch-bar .batch-oprt .btn {
	padding: 8rpx 20rpx;
	font-size: 24rpx;
}

.admin-comm-list .item .batch-check {
	display: inline-block;
	margin-right: 10rpx;
	font-size: 40rpx;
	vertical-align: middle;
}

.admin-comm-list .item.item-selected {
	background: #f0f9ff;
}

