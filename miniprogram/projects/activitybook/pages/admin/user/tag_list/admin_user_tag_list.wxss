@import '../../../../../../style/public/admin.wxss';

.top-bar {
	width: 100%;
	display: flex;
	justify-content: flex-end;
	padding: 0 5rpx 20rpx;
	box-sizing: border-box;
}

.color-dot {
	display: inline-block;
	width: 24rpx;
	height: 24rpx;
	border-radius: 50%;
	margin-right: 14rpx;
	vertical-align: middle;
	border: 2rpx solid rgba(0, 0, 0, 0.08);
	box-sizing: border-box;
}

.tag-title {
	vertical-align: middle;
	font-size: 30rpx;
}

.color-picker {
	display: flex;
	flex-wrap: wrap;
	padding: 10rpx;
}

.color-item {
	width: 64rpx;
	height: 64rpx;
	border-radius: 50%;
	margin: 14rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	position: relative;
	border: 4rpx solid transparent;
	box-sizing: border-box;
}

.color-item.cur {
	border-color: rgba(0, 0, 0, 0.15);
	transform: scale(1.08);
}

.color-check {
	color: #fff;
	font-size: 32rpx;
	font-weight: bold;
}

.input {
	width: 100%;
	height: 80rpx;
	line-height: 80rpx;
	border: 1rpx solid #e5e5e5;
	border-radius: 8rpx;
	padding: 0 20rpx;
	box-sizing: border-box;
	font-size: 28rpx;
	background-color: #fafafa;
}
