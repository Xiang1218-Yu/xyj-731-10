@import '../../../../../../style/public/admin.wxss';

.top-bar {
	width: 100%;
	display: flex;
	justify-content: flex-end;
	padding: 0 5rpx 20rpx;
	box-sizing: border-box;
}

.input {
	width: 100%;
	height: 80rpx;
	line-height: 80rpx;
	border: 1rpx solid #e5e5e5;
	border-radius: 8rpx;
	padding: 0 20rpx;
	box-sizing: border-box;
	font-size: 28rpx;
	background-color: #fafafa;
}
