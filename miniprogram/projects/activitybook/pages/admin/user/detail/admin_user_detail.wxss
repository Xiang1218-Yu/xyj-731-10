@import '../../../../../../style/public/admin.wxss';

.main-admin {
	padding: 30rpx 0rpx;
}

.info-item.pic {
	display: flex;
}

.info-item.pic image{
	width: 180rpx;
	height: 180rpx;
	margin-left: 20rpx;
	border-radius: 2rpx;
}

/* 用户彩色小标签 */
.user-tag {
	font-size: 22rpx;
	padding: 4rpx 16rpx;
	border-radius: 20rpx;
	margin-right: 12rpx;
	margin-bottom: 8rpx;
}

.user-tag.tag-color-0 { background-color: #e8f5e9; color: #43a047; }
.user-tag.tag-color-1 { background-color: #e3f2fd; color: #1e88e5; }
.user-tag.tag-color-2 { background-color: #fff3e0; color: #fb8c00; }
.user-tag.tag-color-3 { background-color: #f3e5f5; color: #8e24aa; }
.user-tag.tag-color-4 { background-color: #ffebee; color: #e53935; }

/* 打标签/设分组弹窗选项 */
.tag-select {
	display: flex;
	flex-wrap: wrap;
	padding: 10rpx 10rpx 0;
}

.tag-select .tag-item {
	display: flex;
	align-items: center;
	font-size: 26rpx;
	color: #555;
	background-color: #f5f5f5;
	border-radius: 8rpx;
	padding: 12rpx 24rpx;
	margin-right: 16rpx;
	margin-bottom: 16rpx;
	border: 1rpx solid transparent;
}

.tag-select .tag-item.cur {
	color: #2499f2;
	background-color: #eaf4fe;
	border: 1rpx solid #2499f2;
}