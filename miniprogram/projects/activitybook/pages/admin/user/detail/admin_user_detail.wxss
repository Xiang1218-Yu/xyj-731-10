@import '../../../../../../style/public/admin.wxss';

.main-admin {
	padding: 30rpx 0rpx;
}

.info-item.pic {
	display: flex;
}

.info-item.pic image{
	width: 180rpx;
	height: 180rpx;
	margin-left: 20rpx;
	border-radius: 2rpx;
}

/* 用户标签展示 */
.user-tag {
	display: inline-block;
	padding: 4rpx 16rpx;
	border-radius: 20rpx;
	color: #fff;
	font-size: 22rpx;
	line-height: 1.6;
	margin-right: 10rpx;
	margin-bottom: 6rpx;
}

/* 标签/分组选择列表 */
.select-list {
	width: 100%;
	max-height: 600rpx;
	overflow-y: auto;
}

.select-item {
	display: flex;
	align-items: center;
	padding: 20rpx 10rpx;
	border-bottom: 1rpx solid #f0f0f0;
}

.select-color {
	width: 24rpx;
	height: 24rpx;
	border-radius: 50%;
	margin-right: 16rpx;
	border: 2rpx solid rgba(0, 0, 0, 0.08);
	box-sizing: border-box;
	flex-shrink: 0;
}

.select-title {
	flex: 1;
	font-size: 28rpx;
	color: #333;
}

.select-check {
	width: 50rpx;
	text-align: right;
	flex-shrink: 0;
}

.empty {
	text-align: center;
	padding: 40rpx 0;
	font-size: 26rpx;
}