@import "../../../style/skin.wxss"; 

.media-box {
	background-color: #fff;
	border-radius: 20rpx;
	padding: 25rpx;
}

.media-title {
	font-size: 28rpx;
	color: #333;
	font-weight: bold;
	margin: 10rpx 0 20rpx 0;
}

.media-pics {
	display: flex;
	flex-wrap: wrap;
}

.media-pic,
.media-pic-add {
	position: relative;
	width: 170rpx;
	height: 170rpx;
	margin: 0 15rpx 15rpx 0;
	border-radius: 12rpx;
	overflow: hidden;
}

.media-pic image {
	width: 100%;
	height: 100%;
}

.media-pic-del {
	position: absolute;
	top: 0;
	right: 0;
	width: 40rpx;
	height: 40rpx;
	border-bottom-left-radius: 12rpx;
	background-color: rgba(0, 0, 0, 0.5);
	color: #fff;
	display: flex;
	align-items: center;
	justify-content: center;
	font-size: 22rpx;
}

.media-pic-add {
	border: 2rpx dashed #ddd;
	background-color: #fafafa;
	display: flex;
	align-items: center;
	justify-content: center;
	color: #bbb;
	font-size: 60rpx;
}

.voice-box {
	width: 100%;
}

.voice-btn {
	width: 260rpx;
	height: 80rpx;
	border-radius: 40rpx;
	background-color: var(--projectColorLight);
	color: #333;
	display: flex;
	align-items: center;
	justify-content: center;
	font-size: 28rpx;
}

.voice-btn text {
	margin: 0 8rpx;
}

.voice-btn.recording {
	background-color: #ff7676;
	color: #fff;
	animation: voicePulse 1s infinite;
}

@keyframes voicePulse {
	0% { opacity: 1; }
	50% { opacity: 0.6; }
	100% { opacity: 1; }
}

.voice-result {
	display: flex;
	align-items: center;
	justify-content: space-between;
}

.voice-play {
	display: flex;
	align-items: center;
	height: 72rpx;
	padding: 0 30rpx;
	border-radius: 36rpx;
	background-color: #f6f7fb;
	color: var(--projectColor);
	font-size: 28rpx;
}

.voice-play text {
	margin-right: 10rpx;
}

.voice-oprt {
	display: flex;
}

.voice-op {
	margin-left: 30rpx;
	font-size: 26rpx;
	color: #666;
}

.location-add {
	width: 220rpx;
	height: 72rpx;
	border-radius: 36rpx;
	background-color: #f6f7fb;
	display: flex;
	align-items: center;
	justify-content: center;
	font-size: 26rpx;
	color: #666;
}

.location-card {
	display: flex;
	align-items: center;
	justify-content: space-between;
	background-color: #f6f7fb;
	border-radius: 12rpx;
	padding: 20rpx;
}

.location-info {
	display: flex;
	align-items: flex-start;
	flex: 1;
}

.location-info .icon-locationfill {
	font-size: 34rpx;
	margin-right: 12rpx;
	margin-top: 4rpx;
}

.location-text {
	flex: 1;
	padding-right: 20rpx;
}

.location-name {
	font-size: 28rpx;
	color: #333;
	font-weight: bold;
}

.location-addr {
	font-size: 24rpx;
	color: #999;
	margin-top: 8rpx;
	line-height: 1.4;
}

.location-del {
	width: 50rpx;
	height: 50rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	color: #999;
	font-size: 26rpx;
}
