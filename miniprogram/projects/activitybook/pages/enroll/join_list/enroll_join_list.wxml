<block wx:if="{{isLoad}}">
	<cmpt-comm-list type="enroll-join-list" search="{{search||''}}" _params="{{_params}}" route="enroll/join_day" isTotalMenu="{{true}}" topBottom="120" placeholder="搜索姓名" bind:list="bindCommListCmpt">
		<view class="number-line" wx:if="{{dataList}}">
			<view class="text-grey">{{day}} <text class="text-red">{{dataList.total}}人</text>完成了打卡</view>
		</view>

		<!-- List Begin -->
		<view class="list">
			<view class="item card-project shadow-project" wx:for="{{dataList.list}}" wx:key="k">
				<image class="left loading" mode="aspectFill" lazy-load="{{true}}" src="{{item.user.USER_PIC}}"></image>
				<view class="right">
					<view class="title">
						<text class="name">{{item.user.USER_NAME}}</text>
						<text class="date">{{item.ENROLL_JOIN_ADD_TIME}}</text>
					</view>
					<view class="content"><text>{{item.ENROLL_JOIN_OBJ.content}}</text></view>

					<view class="album">
						<image bindtap="url" data-type="img" data-imgs="{{item.ENROLL_JOIN_OBJ.img}}" data-url="{{itm}}" wx:for="{{item.ENROLL_JOIN_OBJ.img}}" wx:key="key1" wx:for-item="itm" class="loading  img{{item.ENROLL_JOIN_OBJ.img.length}}" mode="aspectFill" lazy-load="{{true}}" src="{{itm}}"></image>
					</view>

					<view wx:if="{{item.ENROLL_JOIN_PICS&&item.ENROLL_JOIN_PICS.length>0}}" class="album">
						<image bindtap="url" data-type="img" data-imgs="{{item.ENROLL_JOIN_PICS}}" data-url="{{itm}}" wx:for="{{item.ENROLL_JOIN_PICS}}" wx:key="key2" wx:for-item="itm" class="loading img{{item.ENROLL_JOIN_PICS.length}}" mode="aspectFill" lazy-load="{{true}}" src="{{itm}}"></image>
					</view>

					<view wx:if="{{item.ENROLL_JOIN_VOICE}}" bindtap="bindPlayVoice" data-voice="{{item.ENROLL_JOIN_VOICE}}" class="join-voice">
						<text class="icon-voicefill text-project"></text>
						<text class="join-voice-dur">{{item.ENROLL_JOIN_VOICE.duration}}" </text>
					</view>

					<view wx:if="{{item.ENROLL_JOIN_LOCATION}}" bindtap="bindOpenLocation" data-location="{{item.ENROLL_JOIN_LOCATION}}" class="join-location">
						<text class="icon-locationfill text-red margin-right-xxs"></text>
						<view class="join-location-text">
							<view class="join-location-name">{{item.ENROLL_JOIN_LOCATION.name}}</view>
							<view class="join-location-addr">{{item.ENROLL_JOIN_LOCATION.address}}</view>
						</view>
					</view>


				</view>

			</view>
			<!--load begin-->
			<import src="../../../../../tpls/public/list_load_tpl.wxml" />
			<template is="listLoadTpl" data="{{skin:'load-project',dataList}}" />
			<!--load end-->
		</view>
		<!-- List END -->

	</cmpt-comm-list>


</block>
