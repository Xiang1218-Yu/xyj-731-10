<block wx:if="{{isLoad}}">
	<cmpt-comm-list type="enroll-join-list" search="{{search||''}}" _params="{{_params}}" route="enroll/join_day" isTotalMenu="{{true}}" topBottom="120" placeholder="搜索姓名" bind:list="bindCommListCmpt">
		<view class="number-line" wx:if="{{dataList}}">
			<view class="text-grey">{{day}} <text class="text-red">{{dataList.total}}人</text>完成了打卡</view>
		</view>

		<!-- List Begin -->
		<view class="list">
			<view class="item card-project shadow-project" wx:for="{{dataList.list}}" wx:key="k">
				<image class="left loading" mode="aspectFill" lazy-load="{{true}}" src="{{item.user.USER_PIC}}"></image>
				<view class="right">
					<view class="title">
						<text class="name">{{item.user.USER_NAME}}</text>
						<text class="date">{{item.ENROLL_JOIN_ADD_TIME}}</text>
					</view>
					<view class="content"><text>{{item.ENROLL_JOIN_OBJ.content}}</text></view>

				<!-- 功能点：图片打卡展示（独立图片打卡UI + 表单图片合并后的云图片） -->
				<view class="album">
					<image bindtap="url" data-type="img" data-imgs="{{item.ENROLL_JOIN_IMG}}" data-url="{{itm}}" wx:for="{{item.ENROLL_JOIN_IMG}}" wx:key="key1" wx:for-item="itm" class="loading  img{{item.ENROLL_JOIN_IMG.length}}" mode="aspectFill" lazy-load="{{true}}" src="{{itm}}"></image>
				</view>

				<!-- 功能点：语音打卡（点击播放/暂停） -->
				<view class="voice-line {{playingVoice==item.ENROLL_JOIN_VOICE.fileID?'playing':''}}" wx:if="{{item.ENROLL_JOIN_VOICE&&item.ENROLL_JOIN_VOICE.fileID}}" bindtap="bindVoiceTap" data-src="{{item.ENROLL_JOIN_VOICE.fileID}}">
					<text class="icon-voice margin-right-xxs"></text>{{playingVoice==item.ENROLL_JOIN_VOICE.fileID?'播放中…':'语音'}} {{item.ENROLL_JOIN_VOICE.duration}}″
				</view>

				<!-- 功能点：位置打卡展示 -->
				<view class="addr-line" wx:if="{{item.ENROLL_JOIN_ADDRESS}}">
					<text class="icon-location margin-right-xxs"></text>{{item.ENROLL_JOIN_ADDRESS}}
				</view>


			</view>

			</view>
			<!--load begin-->
			<import src="../../../../../tpls/public/list_load_tpl.wxml" />
			<template is="listLoadTpl" data="{{skin:'load-project',dataList}}" />
			<!--load end-->
		</view>
		<!-- List END -->

	</cmpt-comm-list>


</block>