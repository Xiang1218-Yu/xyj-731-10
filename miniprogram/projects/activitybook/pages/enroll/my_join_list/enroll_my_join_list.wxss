@import "../../../style/skin.wxss";

.list {
	width: 100%;
	display: flex;
	flex-direction: column;
} 

.list .item {
	width: 100%;
	display: flex;
	flex-direction: column; /* 功能点：多媒体打卡内容纵向排列 */
	margin-bottom: 30rpx;
	background-color: #fff;
	padding: 30rpx 30rpx;
	border-radius: 25rpx;
} 

/* 功能点：打卡记录头（第N次 + 时间） */
.list .item .head {
	width: 100%;
	display: flex;
	align-items: center;
	justify-content: space-between;
}

.list .item .head .no {
	font-weight: bold;
	color: #333;
}

.list .item .head .time {
	color: #999;
	font-size: 26rpx;
}

/* 功能点：打卡文字内容 */
.list .item .content {
	width: 100%;
	margin-top: 15rpx;
	font-size: 26rpx;
	line-height: 1.3;
	color: #666;
}

/* 功能点：打卡图片 */
.list .item .album {
	width: 100%;
	margin-top: 20rpx;
	display: flex;
	flex-wrap: wrap;
}

.list .item .album image {
	height: 170rpx;
	width: 170rpx;
	margin-right: 10rpx;
	margin-bottom: 10rpx;
	border-radius: 10rpx;
}

/* 功能点：语音打卡样式 */
.list .item .voice-line {
	margin-top: 20rpx;
	display: inline-flex;
	align-items: center;
	align-self: flex-start;
	padding: 12rpx 30rpx;
	border-radius: 30rpx;
	background-color: #f5f5f5;
	color: #333;
	font-size: 24rpx;
}

.list .item .voice-line.playing {
	background-color: var(--projectColor);
	color: #fff;
}

/* 功能点：位置打卡样式 */
.list .item .addr-line {
	margin-top: 15rpx;
	display: flex;
	align-items: center;
	font-size: 24rpx;
	color: #999;
}
