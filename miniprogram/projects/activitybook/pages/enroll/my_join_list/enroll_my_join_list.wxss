@import "../../../style/skin.wxss";

.list {
	width: 100%;
	display: flex;
	flex-direction: column;
}

.list .item {
	width: 100%;
	display: flex;
	flex-direction: column;
	margin-bottom: 30rpx;
	background-color: #fff;
	padding: 30rpx 30rpx;
	border-radius: 25rpx;
}

/* 打卡次数与时间 */
.list .item .my-join-head {
	display: flex;
	align-items: center;
	margin-bottom: 16rpx;
}

.list .item .my-join-badge {
	font-size: 26rpx;
	color: var(--projectColor);
	background-color: #FFF2F0;
	padding: 4rpx 16rpx;
	border-radius: 20rpx;
	margin-right: 16rpx;
}

.list .item .my-join-time {
	font-size: 24rpx;
	color: #ccc;
}

/* 打卡文字内容 */
.list .item .my-join-content {
	width: 100%;
	font-size: 26rpx;
	line-height: 1.5;
	color: #888;
	margin-bottom: 10rpx;
}

/* 打卡图片 */
.list .item .my-join-album {
	margin-top: 10rpx;
	width: 100%;
	display: flex;
	flex-wrap: wrap;
}

.list .item .my-join-album image {
	height: 120rpx;
	width: 120rpx;
	margin-right: 10rpx;
	margin-bottom: 10rpx;
	border-radius: 10rpx;
}

.list .item .my-join-album image.my-join-img1 {
	height: 230rpx;
	width: 230rpx;
}

.list .item .my-join-album image.my-join-img2 {
	height: 200rpx;
	width: 200rpx;
}

.list .item .my-join-album image.my-join-img3,
.list .item .my-join-album image.my-join-img4,
.list .item .my-join-album image.my-join-img5,
.list .item .my-join-album image.my-join-img6,
.list .item .my-join-album image.my-join-img7,
.list .item .my-join-album image.my-join-img8,
.list .item .my-join-album image.my-join-img9 {
	height: 170rpx;
	width: 170rpx;
}

/* ========== 语音播放条 ========== */
.list .item .join-voice-bar {
	margin-top: 20rpx;
	display: flex;
	align-items: center;
	background-color: #f5f5f5;
	border-radius: 12rpx;
	padding: 20rpx 24rpx;
	width: fit-content;
	max-width: 60%;
}

.list .item .join-voice-bar .join-voice-icon {
	font-size: 28rpx;
	color: #07c160;
	margin-right: 12rpx;
	line-height: 1;
}

.list .item .join-voice-bar .join-voice-text {
	font-size: 28rpx;
	color: #333;
}

/* ========== 位置卡片 ========== */
.list .item .join-location-card {
	margin-top: 20rpx;
	display: flex;
	align-items: center;
	background-color: #f5f5f5;
	border-radius: 12rpx;
	padding: 20rpx 24rpx;
}

.list .item .join-location-card .join-location-icon {
	font-size: 36rpx;
	margin-right: 16rpx;
	flex-shrink: 0;
}

.list .item .join-location-card .join-location-info {
	flex: 1;
	min-width: 0;
}

.list .item .join-location-card .join-location-name {
	font-size: 28rpx;
	color: #333;
	font-weight: 500;
	margin-bottom: 4rpx;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.list .item .join-location-card .join-location-address {
	font-size: 24rpx;
	color: #999;
	line-height: 1.4;
	overflow: hidden;
	text-overflow: ellipsis;
	display: -webkit-box;
	-webkit-line-clamp: 2;
	-webkit-box-orient: vertical;
}
