@import "../../../style/skin.wxss";

.list {
	width: 100%;
	display: flex;
	flex-direction: column;
} 

.list .item {
	width: 100%;
	display: flex;
	flex-direction: column;
	margin-bottom: 30rpx;
	background-color: #fff;
	padding: 30rpx;
	border-radius: 25rpx;
} 

.list .my-head {
	width: 100%;
	display: flex;
	align-items: center;
	font-size: 26rpx;
	color: #333;
	font-weight: bold;
}

.list .my-content {
	width: 100%;
	margin-top: 20rpx;
	font-size: 26rpx;
	line-height: 1.5;
	color: #666;
}

.list .album {
	margin-top: 20rpx;
	width: 100%;
	display: flex;
	flex-wrap: wrap;
}

.list .album image {
	height: 140rpx;
	width: 140rpx;
	margin-right: 12rpx;
	margin-bottom: 12rpx;
	border-radius: 10rpx;
}

.list .album image.img1 {
	height: 260rpx;
	width: 260rpx;
}

.list .album image.img2 {
	height: 210rpx;
	width: 210rpx;
}

.list .album image.img3,
.list .album image.img4,
.list .album image.img5,
.list .album image.img6,
.list .album image.img7,
.list .album image.img8,
.list .album image.img9 {
	height: 180rpx;
	width: 180rpx;
}

.list .join-voice {
	margin-top: 20rpx;
	width: 160rpx;
	height: 60rpx;
	border-radius: 30rpx;
	background-color: #f6f7fb;
	display: flex;
	align-items: center;
	justify-content: center;
	font-size: 26rpx;
}

.list .join-voice .icon-voicefill {
	font-size: 32rpx;
	margin-right: 8rpx;
}

.list .join-location {
	margin-top: 20rpx;
	width: 100%;
	display: flex;
	align-items: flex-start;
	background-color: #f6f7fb;
	border-radius: 12rpx;
	padding: 16rpx;
	box-sizing: border-box;
}

.list .join-location .icon-locationfill {
	font-size: 30rpx;
	margin-top: 4rpx;
}

.list .join-location-text {
	flex: 1;
	padding-left: 8rpx;
}

.list .join-location-name {
	font-size: 26rpx;
	color: #333;
	font-weight: bold;
}

.list .join-location-addr {
	font-size: 24rpx;
	color: #999;
	margin-top: 6rpx;
	line-height: 1.4;
}
