.audio-box {
	display: flex;
	flex-direction: row;
	align-items: center;
	flex-wrap: wrap;
}

.audio-btn {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	padding: 12rpx 30rpx;
	border-radius: 40rpx;
	color: #fff;
	margin-right: 20rpx;
	margin-bottom: 10rpx;
	font-size: 28rpx;
}

.audio-btn text {
	color: #fff;
}

.audio-btn-text {
	margin-left: 10rpx;
}

/* 录音中状态展示 */
.audio-recording {
	display: flex;
	flex-direction: row;
	align-items: center;
	margin-right: 20rpx;
	margin-bottom: 10rpx;
}

.audio-wave {
	display: flex;
	flex-direction: row;
	align-items: flex-end;
	height: 40rpx;
	margin-right: 16rpx;
}

.audio-wave-bar {
	width: 8rpx;
	height: 12rpx;
	margin: 0 4rpx;
	background: #e54d42;
	border-radius: 4rpx;
	animation: audioWave 0.8s infinite ease-in-out;
}

.audio-wave-bar:nth-child(2) { animation-delay: 0.15s; }
.audio-wave-bar:nth-child(3) { animation-delay: 0.30s; }
.audio-wave-bar:nth-child(4) { animation-delay: 0.45s; }
.audio-wave-bar:nth-child(5) { animation-delay: 0.60s; }

/* 暂停时冻结波形动画并置灰 */
.audio-wave-paused .audio-wave-bar {
	animation-play-state: paused;
	background: #cccccc;
}

@keyframes audioWave {
	0%, 100% { height: 12rpx; }
	50% { height: 40rpx; }
}

.audio-timer {
	font-size: 28rpx;
	color: #e54d42;
}
