.location-box {
	width: 100%;
	display: flex;
	flex-direction: column;
}

.location-choose {
	padding: 30rpx;
	border: 1rpx dashed #ccc;
	border-radius: 10rpx;
	text-align: center;
	color: #999;
	font-size: 28rpx;
}

.location-info {
	padding: 20rpx;
	background: #f7f7f7;
	border-radius: 10rpx;
}

.location-name {
	font-size: 30rpx;
	font-weight: bold;
}

.location-addr {
	font-size: 24rpx;
	margin-top: 8rpx;
}

.location-oprt {
	display: flex;
	flex-direction: row;
	margin-top: 16rpx;
}

.location-btn {
	padding: 8rpx 30rpx;
	border-radius: 40rpx;
	color: #fff;
	font-size: 26rpx;
	margin-right: 20rpx;
}
