.form-group .picker-base {
	flex: 1;
	text-align: right;
	height: 60rpx;
	line-height: 60rpx;
}

.form-group .picker-select {
	padding-right: 40rpx;
	overflow: hidden;
	position: relative;
}

.form-group .phone-text {
	font-size: 30rpx;
	color: #555;
	flex: 1;
	text-align: left;
}

.form-group .title {
	height: unset !important;
	min-height: 60rpx;
}

.form-group.memo {
	min-height: unset; 
	padding:15rpx 30rpx;
	font-size: 24rpx;
	color:#777;
}

.form-group-line {
	width: 100%;
	padding: 1rpx 30rpx;
	display: flex;
	align-items: center;
	min-height: 100rpx;
	justify-content: center;
	position: relative;
	color: #888;
	font-size: 28rpx;
	margin-top: 10rpx;
}

/* 展示型 */
.form-group-show {
	display: flex;
	align-items: flex-start;
}

.form-group-show .form-group-show-text {
	flex: 1;
	padding: 0rpx 0rpx;
	text-align: left;
	display: flex;
	flex-wrap: wrap;
	min-height: 60rpx;
	align-items: center;
}

.form-group-show .form-group-show-img {
	width: 100rpx;
	height: 100rpx;
	margin-right: 10rpx;
	margin-bottom: 10rpx;
	border-radius: 5rpx;
}




/* 核对信息窗口 */
.modal-check-info {
	width: 100%;
}

.slot-class {
	padding: 0 20rpx 30rpx;
}

.modal-check-info .item {
	width: 100%;
	display: flex;
	justify-content: flex-start;
	align-items: flex-start;
	line-height: 1.8;
	font-size: 30rpx;
	border-bottom: 1rpx dotted #ddd;
	color: #000;
	padding: 10rpx 10rpx;
}

.modal-check-info .item:nth-child(odd) {
	background-color: #f8f8f8;
}

.modal-check-info .item:last-child {
	border-bottom: 0rpx;
}

.modal-check-info .item .title {
	font-weight: bold;
	max-width: 150rpx;
	margin-right: 20rpx;
	text-align: left;
}

.modal-check-info .item .content {
	flex: 1;
	color: #333;
	display: flex;
	justify-content: flex-start;
	align-items: flex-start;
	text-align: left;
}

/* ========== 语音相关样式 ========== */

/* 语音操作区域 */
.voice-actions {
	padding: 10rpx 30rpx 20rpx;
}

.voice-actions .btn {
	margin-bottom: 16rpx;
	font-size: 28rpx;
	border-radius: 12rpx;
}

.voice-record-btn {
	background-color: #07c160 !important;
	color: #fff !important;
}

.voice-choose-btn {
	background-color: #f5f5f5 !important;
	color: #333 !important;
}

.voice-tip {
	text-align: center;
	margin-top: 8rpx;
}

/* 录音中状态 */
.voice-recording {
	padding: 30rpx;
	display: flex;
	flex-direction: column;
	align-items: center;
	background-color: #fef0f0;
	margin: 10rpx 30rpx;
	border-radius: 16rpx;
}

.voice-recording-info {
	display: flex;
	align-items: center;
	margin-bottom: 20rpx;
}

.voice-recording-pulse {
	width: 24rpx;
	height: 24rpx;
	border-radius: 50%;
	background-color: #f56c6c;
	margin-right: 16rpx;
	animation: voice-pulse 1s ease-in-out infinite;
}

@keyframes voice-pulse {
	0% { opacity: 1; transform: scale(1); }
	50% { opacity: 0.5; transform: scale(1.3); }
	100% { opacity: 1; transform: scale(1); }
}

.voice-recording-time {
	font-size: 32rpx;
	color: #f56c6c;
	font-weight: bold;
}

.voice-stop-btn {
	background-color: #f56c6c !important;
	color: #fff !important;
	width: 300rpx;
	font-size: 28rpx;
	border-radius: 12rpx;
}

/* 已上传语音 */
.voice-uploaded {
	padding: 10rpx 30rpx 20rpx;
}

.voice-item {
	display: flex;
	align-items: center;
	background-color: #f5f5f5;
	border-radius: 12rpx;
	padding: 20rpx 24rpx;
}

.voice-play-btn {
	width: 72rpx;
	height: 72rpx;
	border-radius: 50%;
	background-color: #07c160;
	display: flex;
	align-items: center;
	justify-content: center;
	margin-right: 20rpx;
	flex-shrink: 0;
}

.voice-play-icon {
	color: #fff;
	font-size: 32rpx;
	line-height: 1;
}

.voice-info {
	flex: 1;
	display: flex;
	flex-direction: column;
}

.voice-label {
	font-size: 30rpx;
	color: #333;
}

.voice-status {
	margin-top: 4rpx;
}

.voice-delete {
	width: 56rpx;
	height: 56rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	color: #999;
	font-size: 28rpx;
	margin-left: 16rpx;
}

/* 展示模式下的语音 */
.voice-show-item {
	display: flex;
	align-items: center;
	padding: 10rpx 0;
}

.voice-show-item .voice-icon {
	font-size: 28rpx;
	margin-right: 12rpx;
	color: #07c160;
}

.voice-show-item .voice-name {
	font-size: 28rpx;
	color: #333;
}

/* ========== 位置相关样式 ========== */

.location-choose-btn {
	background-color: #f5f5f5 !important;
	color: #333 !important;
	margin: 10rpx 30rpx 20rpx;
	font-size: 28rpx;
	border-radius: 12rpx;
}

.location-selected {
	padding: 10rpx 30rpx 20rpx;
}

.location-card {
	display: flex;
	align-items: center;
	background-color: #f5f5f5;
	border-radius: 12rpx;
	padding: 24rpx;
}

.location-card-icon {
	font-size: 40rpx;
	margin-right: 20rpx;
	flex-shrink: 0;
}

.location-card-info {
	flex: 1;
	min-width: 0;
}

.location-card-name {
	font-size: 30rpx;
	color: #333;
	font-weight: 500;
	margin-bottom: 6rpx;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.location-card-address {
	overflow: hidden;
	text-overflow: ellipsis;
	display: -webkit-box;
	-webkit-line-clamp: 2;
	-webkit-box-orient: vertical;
	line-height: 1.4;
}

.location-card-arrow {
	font-size: 40rpx;
	color: #ccc;
	margin-left: 16rpx;
	flex-shrink: 0;
}

.location-card-actions {
	display: flex;
	margin-top: 16rpx;
	gap: 16rpx;
}

.location-card-actions .btn {
	flex: 1;
	font-size: 26rpx;
	border-radius: 10rpx;
}

.location-rechoose-btn {
	background-color: #fff !important;
	color: #333 !important;
	border: 1rpx solid #ddd !important;
}

.location-delete-btn {
	background-color: #fff !important;
	color: #f56c6c !important;
	border: 1rpx solid #fbc4c4 !important;
}

/* 展示模式下的位置 */
.location-show-item {
	padding: 10rpx 0;
}

.location-show-item .location-name {
	font-size: 28rpx;
	color: #333;
	margin-bottom: 4rpx;
}

.location-show-item .location-address {
	line-height: 1.4;
}